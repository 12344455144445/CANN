// Local test main — runs the first test case
// Usage: ./quant_matmul_relu_quant_custom

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cmath>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
// Dtype enum for TensorInfo.dtype:
// 0=float32 1=float16 2=bfloat16 3=int8 4=int16 5=int32 6=int64
// 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include <vector>
#include "data_utils.h"

#define ACL_CHECK(expr) do { aclError _ret = (expr); if (_ret != 0) { fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, _ret); return 1; } } while(0)
#define FILE_CHECK(expr) do { if (!(expr)) { fprintf(stderr, "[ERROR] File I/O failed at %s:%d\n", __FILE__, __LINE__); return 1; } } while(0)

#include "kernel.asc"

int main()
{
    int32_t deviceId = 0;
    int64_t availableCoreNum = 0;
    aclrtStream stream = nullptr;

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(deviceId));
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_CUBE_CORE_NUM, &availableCoreNum));
    if (availableCoreNum <= 0) {
        return 1;
    }
    ACL_CHECK(aclrtCreateStream(&stream));

    int64_t x1_0_shape[] = {16, 32};
    TensorInfo x1_tensors[] = {{x1_0_shape, 2, 3}};
    TensorGroupInfo info_x1 = {x1_tensors, 1};
    int64_t x2_0_shape[] = {16, 32};
    TensorInfo x2_tensors[] = {{x2_0_shape, 2, 3}};
    TensorGroupInfo info_x2 = {x2_tensors, 1};
    int64_t x1Scale_0_shape[] = {16};
    TensorInfo x1Scale_tensors[] = {{x1Scale_0_shape, 1, 0}};
    TensorGroupInfo info_x1Scale = {x1Scale_tensors, 1};
    int64_t x2Scale_0_shape[] = {16};
    TensorInfo x2Scale_tensors[] = {{x2Scale_0_shape, 1, 0}};
    TensorGroupInfo info_x2Scale = {x2Scale_tensors, 1};
    int64_t y_0_shape[] = {16, 16};
    TensorInfo y_tensors[] = {{y_0_shape, 2, 3}};
    TensorGroupInfo info_y = {y_tensors, 1};
    int64_t yScale_0_shape[] = {16};
    TensorInfo yScale_tensors[] = {{yScale_0_shape, 1, 0}};
    TensorGroupInfo info_yScale = {yScale_tensors, 1};



    uint8_t *inputHost_x1 = nullptr, *inputDevice_x1 = nullptr;
    uint8_t *inputHost_x2 = nullptr, *inputDevice_x2 = nullptr;
    uint8_t *inputHost_x1Scale = nullptr, *inputDevice_x1Scale = nullptr;
    uint8_t *inputHost_x2Scale = nullptr, *inputDevice_x2Scale = nullptr;

    uint8_t *outputHost_y = nullptr, *outputDevice_y = nullptr;
    uint8_t *outputHost_yScale = nullptr, *outputDevice_yScale = nullptr;

    ACL_CHECK(aclrtMallocHost((void **)&inputHost_x1, 512));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_x1, 512, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/x1.bin", 512, inputHost_x1, 512));
    ACL_CHECK(aclrtMemcpy(inputDevice_x1, 512, inputHost_x1, 512, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMallocHost((void **)&inputHost_x2, 512));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_x2, 512, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/x2.bin", 512, inputHost_x2, 512));
    ACL_CHECK(aclrtMemcpy(inputDevice_x2, 512, inputHost_x2, 512, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMallocHost((void **)&inputHost_x1Scale, 64));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_x1Scale, 64, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/x1Scale.bin", 64, inputHost_x1Scale, 64));
    ACL_CHECK(aclrtMemcpy(inputDevice_x1Scale, 64, inputHost_x1Scale, 64, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMallocHost((void **)&inputHost_x2Scale, 64));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_x2Scale, 64, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/x2Scale.bin", 64, inputHost_x2Scale, 64));
    ACL_CHECK(aclrtMemcpy(inputDevice_x2Scale, 64, inputHost_x2Scale, 64, ACL_MEMCPY_HOST_TO_DEVICE));

    ACL_CHECK(aclrtMallocHost((void **)&outputHost_y, 256));
    ACL_CHECK(aclrtMalloc((void **)&outputDevice_y, 256, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMallocHost((void **)&outputHost_yScale, 64));
    ACL_CHECK(aclrtMalloc((void **)&outputDevice_yScale, 64, ACL_MEM_MALLOC_HUGE_FIRST));

    run_kernel((GM_ADDR)inputDevice_x1, info_x1, (GM_ADDR)inputDevice_x2, info_x2, (GM_ADDR)inputDevice_x1Scale, info_x1Scale, (GM_ADDR)inputDevice_x2Scale, info_x2Scale, (GM_ADDR)outputDevice_y, info_y, (GM_ADDR)outputDevice_yScale, info_yScale, availableCoreNum, stream);
    auto sync_ret_ = aclrtSynchronizeStreamWithTimeout(stream, 3000);
    if (sync_ret_ != 0) { fprintf(stderr, "[ERROR] aclrtSynchronizeStreamWithTimeout failed, ret=%d\n", sync_ret_); return 1; }

    ACL_CHECK(aclrtMemcpy(outputHost_y, 256, outputDevice_y, 256, ACL_MEMCPY_DEVICE_TO_HOST));
    FILE_CHECK(WriteFile("./output/y.bin", outputHost_y, 256));
    ACL_CHECK(aclrtMemcpy(outputHost_yScale, 64, outputDevice_yScale, 64, ACL_MEMCPY_DEVICE_TO_HOST));
    FILE_CHECK(WriteFile("./output/yScale.bin", outputHost_yScale, 64));

    if (inputDevice_x1) aclrtFree(inputDevice_x1);
    if (inputHost_x1) aclrtFreeHost(inputHost_x1);
    if (inputDevice_x2) aclrtFree(inputDevice_x2);
    if (inputHost_x2) aclrtFreeHost(inputHost_x2);
    if (inputDevice_x1Scale) aclrtFree(inputDevice_x1Scale);
    if (inputHost_x1Scale) aclrtFreeHost(inputHost_x1Scale);
    if (inputDevice_x2Scale) aclrtFree(inputDevice_x2Scale);
    if (inputHost_x2Scale) aclrtFreeHost(inputHost_x2Scale);
    if (outputDevice_y) aclrtFree(outputDevice_y);
    if (outputHost_y) aclrtFreeHost(outputHost_y);
    if (outputDevice_yScale) aclrtFree(outputDevice_yScale);
    if (outputHost_yScale) aclrtFreeHost(outputHost_yScale);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
